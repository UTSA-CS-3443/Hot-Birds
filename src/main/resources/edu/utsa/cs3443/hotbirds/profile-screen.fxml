<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.espi_test_project.ProfileController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label text="Profile" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <GridPane hgap="12.0" vgap="12.0">
        <Label text="Username" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="usernameLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="fullNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Dashboard" onAction="#onReturnToDashboard"/>
        <Button text="Log out" onAction="#onLogOut"/>
    </HBox>
</VBox>
