<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1024.0" styleClass="background" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.hotbirds.LoginController">
   <children>
      <StackPane prefHeight="768.0" prefWidth="1024.0">
         <children>
            <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="340.0" spacing="12.0">
               <children>
                  <Label styleClass="page-subtitle" text="WELCOME BACK" />
                  <Label styleClass="page-title" text="Sign in">
                     <VBox.margin>
                        <Insets bottom="6.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="emailField" accessibleText="Email or username" maxWidth="Infinity" promptText="Email or username" styleClass="input-field" />
                  <PasswordField fx:id="passwordField" accessibleText="Password" maxWidth="Infinity" promptText="Password" styleClass="input-field" />
                  <Label fx:id="errorLabel" styleClass="subtext" wrapText="true" />
                  <Button defaultButton="true" maxWidth="Infinity" onAction="#onSignIn" styleClass="next-button" text="Sign in" />
                  <Button maxWidth="Infinity" onAction="#onCreateAccount" styleClass="edit-button" text="Create account" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
