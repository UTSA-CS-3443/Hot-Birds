<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="dialog-root" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.hotbirds.AddObservationController">
    <VBox maxHeight="-Infinity" maxWidth="676.0" spacing="22.0" styleClass="dialog-card">
        <VBox spacing="4.0">
            <Label styleClass="dialog-title" text="Confirm Observation" />
            <Label styleClass="subtext" text="Is this the bird that you saw?" />
        </VBox>
      <ImageView fx:id="birdPhoto" fitHeight="272.0" fitWidth="329.0" pickOnBounds="true" preserveRatio="true" />

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="79.0" styleClass="edit-button" text="Go back" />
            <Button onAction="#handleNext" styleClass="next-button" text="Confirm" />
        </HBox>
    </VBox>
</StackPane>
