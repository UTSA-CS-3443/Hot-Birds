<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane styleClass="dialog-root" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.hotbirds.ProfileController">
    <VBox maxHeight="-Infinity" maxWidth="420.0" prefWidth="420.0" spacing="22.0" styleClass="dialog-card">

        <!-- Heading, with the avatar circle used on the observation rows -->
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <StackPane>
                <Circle fill="#EFE3A8" radius="22.0" />
            <ImageView fitHeight="37.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/icons/user.png" />
               </image>
            </ImageView>
            </StackPane>
            <VBox spacing="2.0">
                <Label styleClass="dialog-title" text="Profile" />
                <Label styleClass="subtext" text="Your account details." />
            </VBox>
        </HBox>

        <!-- One field per row: small grey caption above the value -->
        <VBox spacing="4.0">
            <Label styleClass="page-subtitle" text="USERNAME" />
            <Label fx:id="usernameLabel" styleClass="heading" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="page-subtitle" text="NAME" />
            <Label fx:id="fullNameLabel" styleClass="heading" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="page-subtitle" text="EMAIL" />
            <Label fx:id="emailLabel" styleClass="heading" wrapText="true" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button onAction="#onLogOut" prefHeight="40.0" styleClass="edit-button" text="Log out" />
            <Button defaultButton="true" onAction="#onReturnToDashboard" styleClass="next-button" text="Close" />
        </HBox>
    </VBox>
</StackPane>
