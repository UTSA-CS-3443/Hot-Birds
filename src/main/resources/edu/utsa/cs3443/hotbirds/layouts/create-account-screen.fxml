<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1024.0" styleClass="background" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.hotbirds.CreateAccountController">
   <children>
      <StackPane prefHeight="768.0" prefWidth="1024.0">
         <children>
            <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="340.0" spacing="12.0">
               <children>
                  <Label styleClass="page-subtitle" text="WELCOME TO HOT BIRDS" />
                  <Label styleClass="page-title" text="Create account">
                     <VBox.margin>
                        <Insets bottom="6.0" />
                     </VBox.margin>
                  </Label>
                  <HBox spacing="12.0">
                     <children>
                        <TextField fx:id="firstNameField" accessibleText="First name" promptText="First name" styleClass="input-field" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="lastNameField" accessibleText="Last name" promptText="Last name" styleClass="input-field" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <TextField fx:id="usernameField" accessibleText="Username" maxWidth="Infinity" promptText="Username" styleClass="input-field" />
                  <TextField fx:id="emailField" accessibleText="Email" maxWidth="Infinity" promptText="Email" styleClass="input-field" />
                  <PasswordField fx:id="passwordField" accessibleText="Password" maxWidth="Infinity" promptText="Password" styleClass="input-field" />
                  <PasswordField fx:id="confirmPasswordField" accessibleText="Confirm password" maxWidth="Infinity" promptText="Confirm password" styleClass="input-field" />
                  <Label fx:id="errorLabel" styleClass="subtext" wrapText="true" />
                  <Button defaultButton="true" maxWidth="Infinity" onAction="#onCreateAccount" styleClass="next-button" text="Create account" />
                  <Button cancelButton="true" maxWidth="Infinity" onAction="#onCancel" styleClass="edit-button" text="Back to sign in" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
