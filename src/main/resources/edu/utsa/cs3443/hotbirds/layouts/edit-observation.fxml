<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane styleClass="dialog-root" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.hotbirds.AddObservationController">
    <VBox maxHeight="-Infinity" maxWidth="676.0" spacing="22.0" styleClass="dialog-card">
        <VBox prefHeight="51.0" prefWidth="218.0" spacing="4.0">
         <HBox prefHeight="134.0" prefWidth="403.0">
            <children>
                  <Label prefHeight="32.0" prefWidth="300.0" styleClass="dialog-title" text="Edit Observation" />
            </children>
         </HBox>
            <Label styleClass="subtext" text="All fields are required to be filled out." />
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="page-subtitle" text="SPECIES" />
            <ComboBox fx:id="speciesBox" maxWidth="Infinity" promptText="Select a species" styleClass="input-field" />
            <Label styleClass="subtext" text="Choose the species that you have observed." />
        </VBox>

        <HBox spacing="12.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="page-subtitle" text="DATE SEEN" />
                <DatePicker fx:id="datePicker" maxWidth="Infinity" prefWidth="222.0" styleClass="input-field" />
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="page-subtitle" text="TIME SEEN" />
                <TextField fx:id="timeField" promptText="6:40 AM" styleClass="input-field" />
            </VBox>
        </HBox>

        <VBox spacing="6.0">
            <Label styleClass="page-subtitle" text="QUANTITY SEEN" />
            <TextField fx:id="quantityField" promptText="1" styleClass="input-field" />
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="page-subtitle" text="LOCATION SEEN" />
            <TextField fx:id="locationField" promptText="Address or park name" styleClass="input-field" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <Button mnemonicParsing="false" prefHeight="37.0" prefWidth="91.0" styleClass="delete-button-big" text="Delete" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
            <HBox.margin>
               <Insets />
            </HBox.margin>
         </Button>
         <Pane prefHeight="40.0" prefWidth="53.0" />
            <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="79.0" styleClass="edit-button" text="Cancel" />
            <Button onAction="#handleNext" styleClass="next-button" text="Confirm changes" />
        </HBox>
    </VBox>
</StackPane>
